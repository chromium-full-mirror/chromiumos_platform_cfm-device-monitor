if [ "$#" -ne 1 ]; then
  # Wrong number of args
  exit 1
fi

if [ "$1" = "true" ] || [ "$1" = "false" ]; then
  /usr/bin/dbus-send --system --type=method_call \
    --dest=org.chromium.huddlymonitor            \
    /org/chromium/huddlymonitor                  \
    org.chromium.huddlymonitor.UpdateCondition   \
    boolean:$1 uint64:$(/bin/date +%s%3N)
  exit 0
fi

# Unknown argument
exit 1
